{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/run",
      "destination": "/run.html"
    },
    {
      "source": "/free-run",
      "destination": "/free-run.html"
    },
    {
      "source": "/weeks",
      "destination": "/weeks.html"
    },
    {
      "source": "/progress",
      "destination": "/progress.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/workout",
      "destination": "/workout.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}