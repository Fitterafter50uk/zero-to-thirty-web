{
  "expo": {
    "name": "Zero to Thirty",
    "slug": "zero-to-thirty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerotothirty",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Zero to Thirty",
      "shortName": "Zero30",
      "themeColor": "#FF8C00",
      "backgroundColor": "#111111",
      "manifest": "./public/manifest.json"
    },

    "plugins": [
      "expo-router"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}